# Copy to data/.env and fill in your own OpenAI-compatible endpoints.
# BASE_URL is the API prefix (usually ending in /v1), not /chat/completions.
VISION_BASE_URL=xxx
VISION_API_KEY=xxx
VISION_MODEL=xxx

# Two independent models. They receive no image and no reference answer.
BLIND_A_BASE_URL=xxx
BLIND_A_API_KEY=xxx
BLIND_A_MODEL=xxx
BLIND_B_BASE_URL=xxx
BLIND_B_API_KEY=xxx
BLIND_B_MODEL=xxx

# Separate answer-correctness judge.
JUDGE_BASE_URL=xxx
JUDGE_API_KEY=xxx
JUDGE_MODEL=xxx

# Text-only scene-context review and structured-field consistency verification.
REVIEWER_BASE_URL=xxx
REVIEWER_API_KEY=xxx
REVIEWER_MODEL=xxx
